{
  "name": "infinity-mcp-toolbox",
  "version": "0.1.0",
  "description": "Lightweight, secure, read-only MCP tools providing AI coding agents with structured insights into local development projects.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "infinity-mcp-toolbox": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/erfmollaey/infinite-toolbox",
    "directory": "mcp-tools"
  },
  "homepage": "https://github.com/erfmollaey/infinite-toolbox/tree/main/mcp-tools",
  "bugs": {
    "url": "https://github.com/erfmollaey/infinite-toolbox/issues"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "opencode",
    "cursor",
    "developer-tools",
    "read-only",
    "infinity"
  ],
  "author": "Infinity™",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.13.1",
    "eslint": "^9.20.1",
    "prettier": "^3.5.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
